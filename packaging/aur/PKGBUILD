# Maintainer: viniciusorig <vinicius100loucototal at gmail dot com>
pkgname=tabletcfg
pkgver=0.1.0
pkgrel=1
pkgdesc="Graphics tablet configurator for X11/libinput: screen area, rotation, pen pressure and button remapping"
arch=('any')
url="https://github.com/viniciusorig/tabletcfg"
license=('GPL-3.0-or-later')
depends=('python' 'python-gobject' 'gtk3' 'python-pyudev' 'xorg-xinput' 'xorg-xrandr'
         'xf86-input-libinput' 'systemd' 'sudo')
makedepends=('python-build' 'python-installer' 'python-setuptools' 'python-wheel')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')  # troque pelo hash real com `updpkgsums` depois de publicar a tag

build() {
  cd "$pkgname-$pkgver"
  python -m build --wheel --no-isolation
}

check() {
  cd "$pkgname-$pkgver"
  python -m unittest discover -s tests -t .
}

package() {
  cd "$pkgname-$pkgver"
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -Dm644 data/tabletcfg.desktop "$pkgdir/usr/share/applications/tabletcfg.desktop"
  install -Dm644 data/70-tabletcfg-uinput.rules \
    "$pkgdir/usr/lib/udev/rules.d/70-tabletcfg-uinput.rules"
}
